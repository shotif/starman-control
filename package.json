{
  "name": "starman-control",
  "private": true,
  "version": "0.0.1",
  "description": "A 4X strategy game of exploration, colonies and first contact in the Starman Reborn universe.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "vite build",
    "budgets": "node scripts/app/budgets.ts",
    "journey": "playwright test --project=journey-phone",
    "phone-speed": "playwright test --project=speed-phone",
    "balance": "node scripts/app/balance.ts",
    "icons": "node scripts/app/icons.ts",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=phone --project=tablet --project=desktop",
    "screenshots": "playwright test --project=screenshots",
    "art:ping": "node scripts/art/ping.ts",
    "art:generate": "node scripts/art/generate.ts",
    "art:approve": "node scripts/art/approve.ts",
    "art:key": "node scripts/art/key.ts",
    "art:widen": "node scripts/art/widen.ts",
    "art:sheet": "node scripts/art/sheet.ts",
    "art:check": "node scripts/art/check.ts",
    "music:generate": "node scripts/music/generate.ts",
    "music:approve": "node scripts/music/approve.ts",
    "music:check": "node scripts/music/check.ts",
    "voice:cast": "node scripts/voice/cast.ts",
    "voice:pick": "node scripts/voice/pick.ts",
    "data:import": "node scripts/data/import-reborn.ts",
    "data:shell": "node scripts/data/import-shell.ts",
    "data:import-dwarfs": "node scripts/data/import-dwarfs.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm run art:check && npm run music:check && npm test && npm run build && npm run budgets"
  },
  "dependencies": {
    "@fontsource/saira-condensed": "5.3.0",
    "@fontsource/saira-semi-condensed": "5.3.0",
    "@preact/signals": "2.11.3",
    "preact": "10.29.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
